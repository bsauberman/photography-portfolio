.DS_Store
# Camera originals — only the generated -thumb/-full .webp files are committed.
*.JPG
*.jpg
*.JPEG
*.jpeg
*.RAF
# Exception: link-preview covers must be JPEG for clients that can't read WebP.
# Glob (not exact names) so swapping a cover to a new filename stays committed —
# a new filename is how you bust the OG image caches in iMessage/Slack/etc.
!images/og-*.jpg
images/highway-1/DSCF9299-*.webp
